{
  "name": "schedule-stale-comment-issues-and-pulls",
  "description": "Synthetic schedule.repository webhook: stale search (query contains a now-relative updated:< timestamp that must be normalised) finds an issue and a PR, comment posted on both.",
  "event": "schedule",
  "payload": {
    "action": "repository",
    "installation": {
      "id": 4242
    },
    "repository": {
      "id": 500001,
      "node_id": "R_app",
      "name": "app",
      "full_name": "acme/app",
      "private": false,
      "visibility": "public",
      "owner": {
        "login": "acme",
        "id": 9001,
        "type": "Organization"
      },
      "html_url": "https://github.com/acme/app",
      "url": "https://api.github.com/repos/acme/app",
      "issues_url": "https://api.github.com/repos/acme/app/issues{/number}",
      "default_branch": "main",
      "topics": []
    }
  },
  "files": {
    ".github/mergeable.yml": "version: 2\nmergeable:\n  - when: schedule.repository\n    name: Stale\n    validate:\n      - do: stale\n        days: 30\n    pass:\n      - do: comment\n        payload:\n          body: 'This is stale, @author. Repo: @repository'\n"
  },
