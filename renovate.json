{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeDigest",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    "schedule:weekly",
    "schedule:automergeWeekly",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "automergeStrategy": "squash",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "lockFileMaintenance": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)devenv\\.yaml$/"
      ],
      "matchStrings": [
        "url: github:cachix/devenv-nixpkgs/(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "devenv-nixpkgs",
      "packageNameTemplate": "https://github.com/cachix/devenv-nixpkgs",
      "currentValueTemplate": "rolling",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)devenv\\.yaml$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "url: github:cachix/devenv/(?<currentValue>v[0-9.]+)\\?dir=src/modules",
        "DEVENV_VERSION: (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "cachix/devenv",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "cachix/devenv",
        "devenv-nixpkgs"
      ],
      "groupName": "devenv"
    }
  ]
}
